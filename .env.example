# Backend
DATA_PROVIDER=sqlite
PORT=5000
DATABASE_PATH=./backend/data/database.sqlite
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Required by the backend only when DATA_PROVIDER=supabase.
# Never expose SUPABASE_SECRET_KEY in a VITE_* variable or commit a real value.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
AUTH_INVITE_REDIRECT_URL=http://localhost:5173/accept-invite

# Frontends (copy this value to each app's .env file if needed)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Kiosk only
VITE_SCALE_ID=SCALE_01
VITE_SCALE_BAUD_RATE=9600
# Legacy local-development fallback only. Leave unset in public production builds.
# VITE_DEVICE_TOKEN=replace-with-a-provisioned-device-token
# Keep the simulator disabled in production.
VITE_ENABLE_SCALE_SIMULATOR=false
